#!name=IP 纯净度
#!desc=节点 IP 纯净度检测，请先在参数内选择策略组或节点。
#!category=网络检测
#!arguments=Proxy:DIRECT,MarkIP:true
#!arguments-desc=Proxy: 选择策略组或节点，默认 DIRECT | MarkIP: IP 打码(true/false)，默认 true
#!system=ios

[Rule]
# 确保检测请求走选定的代理策略
DOMAIN-SUFFIX,ippure.com,{{{Proxy}}}

[Panel]
IP-Pure = script-name=IP-Pure, title=IP 纯净度, content=刷新中…, style=info, update-interval=300

[Script]
IP-Pure = type=generic, timeout=10, argument={{{MarkIP}}}, script-path=https://raw.githubusercontent.com/vfelix7/rule_module_script/refs/heads/master/surge/scripts/IP_Purity_Surge_Panel.js?v=reference-format-5, script-update-interval=86400

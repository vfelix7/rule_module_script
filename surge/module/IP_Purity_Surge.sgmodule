#!name=IP 纯净度
#!desc=节点 IP 纯净度检测，请先在参数内选择策略组或节点。
#!category=网络检测
#!arguments=Proxy:DIRECT
#!arguments-desc=Proxy: 选择策略组或节点，默认 DIRECT
#!system=ios

[Panel]
IP-Pure = script-name=IP-Pure, title=IP 纯净度, content=刷新中…, style=info, update-interval=300

[Script]
IP-Pure = type=generic, timeout=10, argument={{{Proxy}}}, script-path=https://raw.githubusercontent.com/vfelix7/rule_module_script/master/surge/scripts/IP_Purity_Surge_Panel.js, script-update-interval=86400

#!name=IP 纯净度面板
#!desc=检测指定策略/节点的出口 IP、地区、ASN、网络类型与风险评分。Policy 留空时按当前规则请求。
#!arguments=Policy=
#!category=Panel
#!system=ios

[Panel]
IP-Purity = script-name=ip-purity-panel,update-interval=600

[Script]
ip-purity-panel = type=generic,timeout=12,script-path=https://raw.githubusercontent.com/vfelix7/rule_module_script/refs/heads/master/surge/scripts/IP_Purity_Surge_Panel.js?v=display-policy-2,script-update-interval=86400,argument=Policy=%Policy%&Mark_IP=true
